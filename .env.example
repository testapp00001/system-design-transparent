# Copy to .env for local development: cp .env.example .env
# Every variable can also be set in the real environment (Docker, systemd, k8s).

# Required. Postgres connection string.
DATABASE_URL=postgres://sdt:sdt@localhost:5432/sdt

# Address to listen on.
BIND_ADDR=0.0.0.0:3000

# Max connections in the pool, per app instance. Remember: instances x pool size
# must stay below Postgres' max_connections (default 100).
DATABASE_MAX_CONNECTIONS=10

# Secret used to hash voter IP addresses. Use a long random value in production
# (e.g. `openssl rand -hex 32`). Changing it resets "who already voted".
IP_HASH_SECRET=dev-only-insecure-secret-change-me

# How many reverse proxies sit in front of the app and append to
# X-Forwarded-For. 0 = the app is directly exposed. 1 = one proxy such as
# Caddy, nginx or a cloud load balancer. Getting this wrong lets visitors fake
# their IP (too high) or makes everyone look like the proxy (too low).
TRUSTED_PROXY_HOPS=0

# Set to true when the site is served over HTTPS so cookies get the Secure flag.
COOKIE_SECURE=false

# Public origin, used for absolute links in the RSS feed and sitemap.
PUBLIC_URL=http://localhost:3000

# Repository used for "Improve this page on GitHub" links.
REPO_URL=https://github.com/testapp00001/system-design-transparent

# Run periodic jobs (closing vote rounds, cleaning sessions) in this process.
# Safe to leave on for every instance: jobs use advisory locks.
RUN_BACKGROUND_JOBS=true

# Where content and static files live (relative to the working directory).
CONTENT_DIR=content
STATIC_DIR=static

# Log filter, see https://docs.rs/tracing-subscriber (EnvFilter).
RUST_LOG=info,sqlx=warn,tower_http=info
